  "patch_set": {
   "confirmed_by_smoke": "X = 3/10 needs the p = 2 factor (v_2 = -1); integers need none -- see SMOKE2.md",
   "value": [
    2,
    3,
    5,
    7,
    11,
    13,
    17,
    19,
    23
   ],
   "why": "the polynomial defines U_{w in V_K minus S0} m_w with the prescribed S0 = empty: Q \\ Z = {X : 1/X in U_{all w} m_w}.  The freezing construction uses S = {2}, so Sun's return step (9.4) adjoins U_{v in S minus S0} m_v = m_2.  Patch set = E_exc u {2}."
  },
  "pi": 2,
  "substitution_note": {
   "h_bridge_variable": "iota, not X: the polynomial defines the INVERSE image of U m_w (Sun (1.1) duality), so Sun's x is iota with X*iota = 1",
   "patch": "F_p = pi_p G_p - p^2 X^2.  The O_(p) formula is applied to x = 1/(pX), so pi x^2 G = 1 clears to pi G = p^2 X^2.  The earlier draft's pi X^2 G - p^2 encodes X in m_p instead -- the wrong side of the duality.",
   "why_it_matters": "U_w m_w is a proper subset of Q minus Z (e.g. 1/3 is in Q minus Z but in no m_w), so the un-inverted reading defines too small a set"
  },
  "u": 1
 },
 "expansion_status": {
  "F": "F_main^2 and (F_main*F_patch)^2 put the expanded single term list past 1e13 terms; expansion remains infeasible and is not attempted",
  "F_Theta": "product of 8 factors of [2022, 2347] terms",
  "F_patch": "product of 8 factors of 7 terms each",
  "literal": "every constant, every leaf factor, as a hashed sparse term list; the whole F as a straight-line program (F_eval.py), verified equal to the leaves"
 },
 "fold_justification": {
  "E1": "over Q (ordered), f = 0 and g = 0 <=> f^2 + g^2 = 0",
  "E2": "f*g = 0 <=> f = 0 or g = 0 (union by padded product; witnesses shared)",
  "E3": "product over Lambda realises the disjunction; zeta kills delta_tau = 0, zeta' the D = 0 case",
  "E4": "X*iota = 1 forces X != 0"
 },
 "formulas": {
  "A": "1 + 4*a^2",
  "B": "b*pi = 2*b",
  "D": "(1+4*a^2)*b^2*(1 - z - a^2*z^2)",
  "F": "(F_main * F_patch)^2 + (X*iota - 1)^2",
  "F_Phi": "(b*b1 - 1 - sigma*Pi_S)^2 + (a - u - upsilon*Pi_S)^2",
  "F_Theta": "prod over tau in Lambda of [(delta_tau*zeta - 1)^2 + Phat_tau^2 + ((D*zeta' - 1)*P0_tau)^2]",
  "F_main": "F_Phi^2 + F_Theta^2",
  "F_p": "pi_p*((1+4A_p)(s1 - s1^2) + (a_p - A_p) - B_p*(s2^2 + s2*s3 - A_p*s3^2)) - p^2*X^2",
  "F_patch": "prod over p in E_exc of F_p   (witnesses s1,s2,s3 = y,r,s shared)",
  "G": "16*a^4*b^2 - (b-1)^4*(1+4*a^2)",
  "N": "a^2*z^2*G",
  "P0_tau": "-delta_tau*A*y^2 - 16*B*(r^2 - A*s^2) - 16",
  "Phat_tau": "delta_tau*(N^2 - A*y^2*D^2) - 16*B*(r^2 - A*s^2)*D^2 - 16*D^2",
  "delta_tau": "1 - A*tau^2",
  "z": "iota^3"
 },
 "target": "X in Q : X not in Z  <=>  exists (a,b,b1,sigma,upsilon,y,r,s,zeta,zetap,iota) in Q^11: F = 0",
